# انسخ إلى .env.local (محليًا) أو أضفها في Vercel → Settings → Environment Variables
# إلزاميان على الإنتاج:
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# عنوان خدمة دمج الفيديو (مشروع merger-site المنشور على Vercel)
MERGER_API_BASE=https://<merger-site>.vercel.app

# اختياري:
MCP_ACCESS_TOKEN=            # إن ضُبط يُطلب Bearer token على /mcp (يظهر في الواجهة و health)
KIE_IMAGE_MODEL=             # تجاوز أسماء الموديلات إن لزم
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
KIE_API_BASE=                # الافتراضي https://api.kie.ai/api/v1/jobs
COMETAPI_BASE_URL=           # الافتراضي https://api.cometapi.com
