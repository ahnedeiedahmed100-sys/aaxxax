# انسخ هذا الملف إلى .env وضع القيم الحقيقية — بلا أسرار في المستودع
# قاعدة Turso: أنشئها بـ `turso db create <name>` ثم `turso db show <name> --url` و `turso db tokens create <name>`
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# اختياري: تجاوز ثنائيات ffmpeg إن لزم (الافتراضي ffmpeg-static)
FFMPEG_BIN=
FFPROBE_BIN=

# اختياري: تعديل الحدود (الافتراضيات وفق المواصفة)
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
